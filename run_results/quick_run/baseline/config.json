{
  "amp": true,
  "batch_size": 256,
  "cam_layer": "layer4",
  "data_dir": "./data",
  "dataset": "cifar100",
  "epochs": 80,
  "gamma": 0.1,
  "label_smoothing": 0.05,
  "log_every": 1000,
  "lr": 0.15,
  "mask_area": 0.2,
