  "min_lr": 5e-05,
  "model": "resnet18",
  "momentum": 0.9,
  "nesterov": true,
  "num_workers": 4,
  "out_dir": "run_results/quick_run",
  "run_name": "baseline",
  "scheduler": "cosine",
  "seed": 42,
  "val_split": 0.1,
  "warmup_epochs": 5,
  "weight_decay": 0.0005
}