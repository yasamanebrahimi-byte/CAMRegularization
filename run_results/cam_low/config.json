{
  "amp": true,
  "batch_size": 128,
  "cam_layer": "layer2",
  "data_dir": "./data",
  "dataset": "cifar100",
  "epochs": 150,
  "gamma": 0.1,
  "label_smoothing": 0.05,
  "log_every": 1000,
  "lr": 0.1,
  "mask_area": 0.2,
  "mask_block": 8,
  "mask_prob": 0.5,
  "mask_warmup_epochs": 0,
  "masking": "cam_low",
  "milestones": "60,80",
  "min_lr": 1e-05,
  "model": "resnet18",
  "momentum": 0.9,
  "nesterov": true,
  "num_workers": 2,
  "out_dir": "./run_results",
  "run_name": "cam_low",
  "scheduler": "cosine",
  "seed": 42,
  "val_split": 0.1,
  "warmup_epochs": 5,
  "weight_decay": 0.0005
}