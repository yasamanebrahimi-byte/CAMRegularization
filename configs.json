{
    "_description": "Recommended hyperparameters for the CAM Masking Comparison Pipeline. Resolution order: defaults < model_defaults < dataset_defaults < overrides[model::dataset]. Only parameters that differ from the layer below need to be specified.",

    "defaults": {
        "lr": 0.1,
        "momentum": 0.9,
        "weight_decay": 5e-4,
        "scheduler": "cosine",
        "warmup_epochs": 5,
        "min_lr": 1e-5,
        "gamma": 0.1,
        "milestones": "60,80",
        "label_smoothing": 0.0,
        "nesterov": false,
        "amp": false,
        "batch_size": 128,
        "num_workers": 4,
        "epochs": 200,
        "val_split": 0.1,
        "log_every": 100
    },

    "model_defaults": {
        "resnet18": {
            "lr": 0.1,
            "weight_decay": 5e-4,
            "nesterov": true
        },
        "resnet34": {
            "lr": 0.1,
            "weight_decay": 5e-4,
            "nesterov": true
        },
        "resnet50": {
            "lr": 0.1,
            "weight_decay": 1e-4,
            "nesterov": true
        },
        "vgg16_bn": {
            "lr": 0.05,
            "weight_decay": 5e-4,
            "nesterov": false
        },
        "densenet121": {
            "lr": 0.1,
            "weight_decay": 1e-4,
            "nesterov": true
        },
        "mobilenet_v3_small": {
            "lr": 0.01,
            "weight_decay": 1e-5,
            "nesterov": true
        },
        "mobilenet_v3_large": {
            "lr": 0.01,
            "weight_decay": 1e-5,
            "nesterov": true
        },
        "efficientnet_b0": {
            "lr": 0.05,
            "weight_decay": 1e-4,
            "nesterov": true
        },
        "vit_b_16": {
            "lr": 0.01,
            "weight_decay": 0.05,
            "warmup_epochs": 10,
            "label_smoothing": 0.1,
            "nesterov": false
        }
    },

    "dataset_defaults": {
        "cifar100": {
            "batch_size": 128,
            "num_workers": 4,
            "epochs": 200
        },
        "tiny_imagenet": {
            "batch_size": 128,
            "num_workers": 4,
            "epochs": 200
        },
        "cub200": {
            "batch_size": 32,
            "num_workers": 4,
            "epochs": 100
        },
        "malimg": {
            "batch_size": 32,
            "num_workers": 2,
            "epochs": 100
        },
        "malware_classification": {
            "batch_size": 64,
            "num_workers": 2,
            "epochs": 100
        },
        "big2015": {
            "batch_size": 64,
            "num_workers": 2,
            "epochs": 100
        }
    },

    "overrides": {
        "vgg16_bn::cifar100": {
            "lr": 0.01,
            "batch_size": 64
        },
        "vgg16_bn::tiny_imagenet": {
            "lr": 0.01,
            "batch_size": 64
        },
        "vit_b_16::cifar100": {
            "lr": 0.005,
            "warmup_epochs": 15,
            "epochs": 300
        },
        "vit_b_16::tiny_imagenet": {
            "lr": 0.005,
            "warmup_epochs": 15,
            "epochs": 300
        },
        "vit_b_16::cub200": {
            "lr": 0.005,
            "warmup_epochs": 10,
            "epochs": 150
        },
        "resnet18::cub200": {
            "lr": 0.01,
            "weight_decay": 1e-4
        },
        "resnet34::cub200": {
            "lr": 0.01,
            "weight_decay": 1e-4
        },
        "resnet50::cub200": {
            "lr": 0.01
        },
        "mobilenet_v3_small::cub200": {
            "lr": 0.005,
            "epochs": 150
        },
        "mobilenet_v3_large::cub200": {
            "lr": 0.005,
            "epochs": 150
        }
    }
}
