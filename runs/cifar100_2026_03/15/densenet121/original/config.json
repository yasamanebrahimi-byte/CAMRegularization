{
  "amp": false,
  "batch_size": 128,
  "data_dir": "./data",
  "dataset": "cifar100",
  "epochs": 200,
  "gamma": 0.1,
  "label_smoothing": 0.0,
  "log_every": 100,
  "lr": 0.1,
  "milestones": "60,80",
